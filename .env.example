# ===================================================================
# CodeMentor — Environment Variables Template
# ===================================================================

# -------------------------------------------------------------------
# 1. Spring Boot Backend (Authoritative REST API)
# -------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=default
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/studytrackerdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password
JWT_SECRET=your-32-byte-or-longer-production-jwt-secret-key-here!
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
RAG_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# -------------------------------------------------------------------
# 2. Python GenAI / RAG Service (Vector Search Microservice)
# -------------------------------------------------------------------
RAG_PORT=8000
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# -------------------------------------------------------------------
# 3. React Frontend (Vite)
# -------------------------------------------------------------------
# Optional in dev (defaults to relative proxy through Vite server)
VITE_API_BASE_URL=
